{
  "entities": {
    "Movie": {
      "title": "Movie",
      "description": "Represents a movie or TV show with multiple video streaming servers",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the movie" },
        "description": { "type": "string", "description": "Brief summary or description of the movie" },
        "year": { "type": "string", "description": "The release year of the movie" },
        "category": { "type": "string", "description": "Category: Movie, Series, Anime, etc." },
        "genre": { "type": "string", "description": "Genre tags of the movie" },
        "rating": { "type": "string", "description": "IMDb rating or viewer rating" },
        "posterUrl": { "type": "string", "description": "The URL of the movie poster image" },
        "bannerUrl": { "type": "string", "description": "An optional banner image URL for the movie detail page header" },
        "servers": {
          "type": "array",
          "description": "List of video hosting/streaming servers"
        },
        "isTrending": { "type": "boolean", "description": "Flag to mark the movie as trending" },
        "views": { "type": "integer", "description": "Number of clicked sessions or movie views" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Database insertion timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Database modification timestamp" }
      },
      "required": ["title", "category", "posterUrl"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Represents a movie review or comment from an authenticated user",
      "type": "object",
      "properties": {
        "movieId": { "type": "string", "description": "The ID of the target movie" },
        "userId": { "type": "string", "description": "The author's user ID" },
        "userName": { "type": "string", "description": "Display name of the user" },
        "userEmail": { "type": "string", "description": "Email address of the user" },
        "userPhoto": { "type": "string", "description": "Profile picture URL of the user" },
        "text": { "type": "string", "description": "Text content of the comment" },
        "rating": { "type": "integer", "description": "Rating score out of 5 stars" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Database insertion timestamp" }
      },
      "required": ["movieId", "userId", "text", "rating"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Indicates a bookmarked or favorited movie linked to a user profile",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["movieId", "userId"]
    },
    "Watchlist": {
      "title": "Watchlist",
      "description": "Represents a movie in a user's watch list for later viewing",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["movieId", "userId"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "Custom curated movie collection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "theme": { "type": "string" },
        "likes": { "type": "integer" },
        "likedBy": { "type": "array" },
        "movieIds": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Direct user messages or global announcements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message"]
    },
    "OnlineUser": {
      "title": "OnlineUser",
      "description": "Represents a user currently online on the site",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "photoURL": { "type": "string" },
        "userAgent": { "type": "string" },
        "enteredAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "userName"]
    },
    "VisitLog": {
      "title": "VisitLog",
      "description": "Represents a single recorded user visit session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "photoURL": { "type": "string" },
        "userAgent": { "type": "string" },
        "enteredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "userName", "enteredAt"]
    },
    "Moderator": {
      "title": "Moderator",
      "description": "Represents an assistant administrator with specific action permissions",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "The email address of the moderator" },
        "role": { "type": "string" },
        "canPublish": { "type": "boolean" },
        "canEdit": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "addedBy": { "type": "string" }
      },
      "required": ["email", "canPublish", "canEdit"]
    }
  },
  "firestore": {
    "/moderators/{email}": {
      "schema": "Moderator",
      "description": "Assistant moderators invited by the superadmin"
    },
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "The movies and series collection managed by the site admin"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Reviews and comments posted on movies"
    },
    "/favorites/{favId}": {
      "schema": "Favorite",
      "description": "Saved favorite items of registered users"
    },
    "/watchlist/{watchId}": {
      "schema": "Watchlist",
      "description": "List of pending items to watch later"
    },
    "/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "User curated playlists and collections"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications and global announcements feed"
    },
    "/online_users/{sessionId}": {
      "schema": "OnlineUser",
      "description": "Tracks real-time online presence of users"
    },
    "/visit_logs/{logId}": {
      "schema": "VisitLog",
      "description": "Tracks history of user and guest visits"
    }
  }
}
