rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Movies Collection Rules
    match /movies/{movieId} {
      // Anyone can view movies (get and list) to keep the frontend public and fast
      allow read: if true;

      // Only the authenticated site administrator can create or delete
      allow create, delete: if request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com";

      // Site administrator can update anything, other users can ONLY update the 'views' field for view counters
      allow update: if (request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com") || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Comments & Reviews Rules
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // Favorites Rules
    match /favorites/{favId} {
      allow read, write: if true;
    }

    // Watchlist Rules
    match /watchlist/{watchId} {
      allow read, write: if true;
    }
  }
}
