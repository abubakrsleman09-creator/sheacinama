rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Movies Collection Rules
    match /movies/{movieId} {
      // Anyone can view movies (get and list) to keep the frontend public and fast
      allow read: if true;

      // Only the authenticated site administrator (user: abubakrsleman09@gmail.com) can write movies
      allow create, update, delete: if request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com" && 
        request.auth.token.email_verified == true;
    }
  }
}
