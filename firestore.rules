rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Movies Collection Rules
    match /movies/{movieId} {
      // Anyone can view movies (get and list) to keep the frontend public and fast
      allow read: if true;

      // Only the authenticated site administrator can create or delete
      allow create, delete: if request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com";

      // Site administrator can update anything, other users can ONLY update the 'views' field for view counters
      allow update: if (request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com") || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Comments & Reviews Rules
    match /comments/{commentId} {
      // Anyone can view comments
      allow read: if true;

      // Authenticated users can write comments under their own userId
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;

      // Comment owners can edit, but other logged-in users can toggle upvoting helpfulCount/helpfulBy
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulBy', 'helpfulCount'])
      );

      // Only the author can delete their comment
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }

    // Favorites Rules
    match /favorites/{favId} {
      allow read, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }

    // Watchlist Rules
    match /watchlist/{watchId} {
      allow read, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }

    // Profiles Rules
    match /profiles/{profileId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == profileId;
    }

    // Watch History Rules
    match /watch_history/{historyId} {
      allow read, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }

    // Playlists Rules
    match /playlists/{playlistId} {
      // Public playlists can be viewed by anyone; private playlists can only be viewed by the owner
      allow read: if resource.data.isPublic == true || 
        (request.auth != null && resource.data.userId == request.auth.uid);

      // Authenticated users can create playlists under their own userId
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;

      // Playlist owners can edit details, but other logged in users can toggle liking/unliking playlists
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      );

      // Only the playlist owner can delete their playlist
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }

    // Notifications Rules
    match /notifications/{notificationId} {
      // Users can read public notifications or private direct notifications meant for them
      allow read: if resource.data.userId == "public" || 
        (request.auth != null && resource.data.userId == request.auth.uid);

      // Authenticated users can trigger/create system notifications
      allow create: if request.auth != null;

      // Recipients can update (e.g. mark as read) or delete their notifications
      allow update, delete: if request.auth != null && 
        (resource.data.userId == request.auth.uid || resource.data.userId == "public");
    }

    // Active Watch session rules (Real-time live monitoring)
    match /active_watches/{sessionId} {
      allow read, write: if true;
    }

    // Real-time online presence rules
    match /online_users/{sessionId} {
      allow read, write: if true;
    }

    // Visit logs rules
    match /visit_logs/{logId} {
      // Anyone can record their visit
      allow create: if true;

      // Only the authenticated admin can read or delete the visit history
      allow read, delete: if request.auth != null && 
        request.auth.token.email == "abubakrsleman09@gmail.com";
    }
  }
}
